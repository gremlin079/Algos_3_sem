@page
@model TaxiCompanyApp.Pages.Trips.IndexModel

<h2>Поездки</h2>

<p>
    <a asp-page="Create" class="btn btn-primary">Добавить поездку</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Откуда</th>
            <th>Куда</th>
            <th>Дата и время</th>
            <th>Стоимость</th>
            <th>Водитель</th>
            <th>Автомобиль</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Trips)
        {
                <tr>
                    <td>@item.FromAddress</td>
                    <td>@item.ToAddress</td>
                    <td>@item.TripDate.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@item.Price.ToString("C")</td>
                    <td>@item.Driver?.FirstName @item.Driver?.LastName</td>
                    <td>@item.Car?.Brand @item.Car?.Model</td>
                    <td>
                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Редактировать</a>
                        <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Детали</a>
                        <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Удалить</a>
                    </td>
                </tr>
        }
    </tbody>
</table>