@page
@model TaxiCompanyApp.Pages.Cars.IndexModel

<h2>Автомобили</h2>

<p>
    <a asp-page="Create" class="btn btn-primary">Добавить автомобиль</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Марка</th>
            <th>Модель</th>
            <th>Гос. номер</th>
            <th>Год выпуска</th>
            <th>Цвет</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Cars)
        {
                <tr>
                    <td>@item.Brand</td>
                    <td>@item.Model</td>
                    <td>@item.LicensePlate</td>
                    <td>@item.Year</td>
                    <td>@item.Color</td>
                    <td>
                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Редактировать</a>
                        <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Детали</a>
                        <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Удалить</a>
                    </td>
                </tr>
        }
    </tbody>
</table>
