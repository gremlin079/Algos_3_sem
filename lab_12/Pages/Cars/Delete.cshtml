@page
@model TaxiCompanyApp.Pages.Cars.DeleteModel

<h2>Удалить автомобиль</h2>

<h3>Вы уверены, что хотите удалить этот автомобиль?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Марка</dt>
        <dd class="col-sm-10">@Model.Car.Brand</dd>
        <dt class="col-sm-2">Модель</dt>
        <dd class="col-sm-10">@Model.Car.Model</dd>
        <dt class="col-sm-2">Гос. номер</dt>
        <dd class="col-sm-10">@Model.Car.LicensePlate</dd>
        <dt class="col-sm-2">Год выпуска</dt>
        <dd class="col-sm-10">@Model.Car.Year</dd>
        <dt class="col-sm-2">Цвет</dt>
        <dd class="col-sm-10">@Model.Car.Color</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Car.Id" />
        <input type="submit" value="Удалить" class="btn btn-danger" />
        <a asp-page="./Index" class="btn btn-secondary">Назад к списку</a>
    </form>
</div>
