@page
@model TaxiCompanyApp.Pages.Drivers.DeleteModel

<h2>Удалить водителя</h2>

<h3>Вы уверены, что хотите удалить этого водителя?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Имя</dt>
        <dd class="col-sm-10">@Model.Driver.FirstName</dd>
        <dt class="col-sm-2">Фамилия</dt>
        <dd class="col-sm-10">@Model.Driver.LastName</dd>
        <dt class="col-sm-2">Телефон</dt>
        <dd class="col-sm-10">@Model.Driver.Phone</dd>
        <dt class="col-sm-2">Лицензия</dt>
        <dd class="col-sm-10">@Model.Driver.LicenseNumber</dd>
        <dt class="col-sm-2">Стаж</dt>
        <dd class="col-sm-10">@Model.Driver.Experience</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Driver.Id" />
        <input type="submit" value="Удалить" class="btn btn-danger" />
        <a asp-page="./Index" class="btn btn-secondary">Назад к списку</a>
    </form>
</div>