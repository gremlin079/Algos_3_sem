<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TaxiParkAppMobile1.Pages.CarsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Авто">
    <Grid
        Padding="16"
        RowDefinitions="*,Auto">

        <CollectionView
            x:Name="CarsCollection"
            Grid.Row="0"
            ItemsSource="{Binding Cars}"
            SelectionMode="Single"
            SelectionChanged="OnCarSelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem
                                    BindingContext="{Binding .}"
                                    BackgroundColor="#C62828"
                                    Invoked="OnCarDeleteRequested"
                                    Text="Удалить" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Grid Padding="12">
                            <Label FontAttributes="Bold" Text="{Binding Brand}" />
                            <Label Text="{Binding Model}" />
                            <Label Text="{Binding LicensePlate}" />
                            <Label Text="{Binding Year, StringFormat='Год: {0}'}" />
                            <Label Text="{Binding Color, StringFormat='Цвет: {0}'}" />
                        </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ScrollView Grid.Row="1" Margin="0,12,0,0">
            <VerticalStackLayout Spacing="8">
                <Label FontAttributes="Bold" Text="Добавить / изменить" />
                <Entry x:Name="BrandEntry" Placeholder="Марка" />
                <Entry x:Name="ModelEntry" Placeholder="Модель" />
                <Entry x:Name="PlateEntry" Placeholder="Гос. номер" />
                <Entry
                    x:Name="YearEntry"
                    Keyboard="Numeric"
                    Placeholder="Год выпуска" />
                <Entry x:Name="ColorEntry" Placeholder="Цвет" />
                <Grid ColumnDefinitions="*,*">
                    <Button
                        Grid.Column="0"
                        Clicked="OnSaveCar"
                        Text="Сохранить" />
                    <Button
                        Grid.Column="1"
                        BackgroundColor="#9E9E9E"
                        Clicked="OnClearCar"
                        Text="Очистить" />
                </Grid>
                <Button
                    x:Name="DeleteCarButton"
                    BackgroundColor="#C62828"
                    Clicked="OnDeleteCar"
                    IsEnabled="False"
                    Text="Удалить выбранный" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

